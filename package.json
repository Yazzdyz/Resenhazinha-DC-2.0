{
  "name": "resenhazinha",
  "version": "4.3.1",
  "private": true,
  "type": "module",
  "description": "Resenhazinha com servidor persistente, perfis sincronizados e atualização automática via GitHub Releases.",
  "main": "electron/bootstrap.cjs",
  "author": "Guilherme",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "check": "npm test && node --check src/main.js && node --check src/call-session-manager.js && node --check electron/main.cjs && node --check electron/preload.cjs && npm run build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "peerjs": "^1.5.5"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cross-env": "^10.0.0",
    "electron": "^43.6.0",
    "electron-builder": "26.16.0",
    "loopback-capture": "^2.0.0",
    "vite": "^7.1.5",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.yazzdyz.resenhazinha",
    "productName": "Resenhazinha",
    "asar": true,
    "npmRebuild": false,
    "directories": { "output": "release" },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json",
      "!src/**/*",
      "!release/**/*",
      "!.github/**/*",
      "!upload/**/*",
      "!*.zip"
    ],
    "extraResources": [
      { "from": "node_modules/loopback-capture/build/Release/loopback_capture_addon.node", "to": "loopback_capture_addon.node" },
      { "from": "THIRD_PARTY_NOTICES.txt", "to": "THIRD_PARTY_NOTICES.txt" }
    ],
    "win": {
      "target": [{ "target": "nsis", "arch": ["x64"] }],
      "icon": "public/icon.ico",
      "artifactName": "Resenhazinha-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Resenhazinha",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [{
      "provider": "github",
      "owner": "Yazzdyz",
      "repo": "Resenhazinha-DC-2.0",
      "releaseType": "release",
      "tagNamePrefix": "v"
    }]
  }
}
